# ============================================================ Kernel Source ===
KERNEL_SOURCE="https://github.com/Vikram5fbd009/Overclock_mt6833"
KERNEL_BRANCH="flyme"
DEFCONFIG_NAME="camellia_defconfig"
KERNEL_IMAGE_NAME="Image.gz-dtb"

# ================================================================== Toolchain ===
# AOSP Clang r450784e is the safest for old 4.14 kernels
CLANG_SOURCE="git"
CLANG_BRANCH="master-kernel-build-2022"
CLANG_VERSION="r450784e"
GCC_GNU="true"

# ================================================================ KernelSU ===
# This selects BakaSU (backslashxx)
KERNELSU_SOURCE="backslashxx"
KERNELSU_BRANCH=""
KERNELSU_NAME="backslashxx"

# ==================================================================== SUSFS ===
SUSFS_ENABLE="true"
SUSFS_FIXED="true"

# ================================================================ Patches ===
# Required for kernels older than 5.9
ENABLE_PATH_UMOUNT="true"

# ============================================================== AnyKernel3 ===
AK3_SOURCE="https://github.com/osm0sis/AnyKernel3.git"
